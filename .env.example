# EduConnect environment template.
# Copy to `.env` and fill in real values from your local secret store (1Password / Vault / Railway / AWS SM).
# NEVER commit a populated `.env`.

NODE_ENV=development
PORT=3000

# ── Postgres ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/educonnect

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@localhost:6379

# ── JWT (MUST be ≥32 characters; generate with: openssl rand -base64 48) ─────────
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-of-randomness
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-of-randomness
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend origins ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081
WEB_ADMIN_URL=http://localhost:3001

# ── Optional integrations ───────────────────────────────────────────────────────
# Real values come from the provider's dashboard; do not commit.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
RESEND_API_KEY=replace-me
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"replace-me"}
